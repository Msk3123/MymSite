# Скопіюйте в /opt/sites/.env на сервері й заповніть. Сам .env — НІКОЛИ не в git.

# Пароль PostgreSQL (будь-який довгий випадковий рядок: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Домен «Маминої шафи». Без свого домену: shafa.<IP-через-дефіси>.sslip.io
SHAFA_DOMAIN=shafa.134-209-235-187.sslip.io

# Хеш пароля кабінету: dotnet run --project src/SiteMym.Api -- hash-password "пароль"
SHAFA_ADMIN_PASSWORD_HASH=

# Ключ OpenAI для помічника (порожньо — помічник вимкнений, решта працює)
OPENAI_API_KEY=
